# API Keys (Ollama needs a non-empty placeholder)


GEMINI_API_KEY=""

# Connection Settings - Force the redirect
# OLLAMA="http://172.17.0.1:11434"
# OPENAI_API_BASE="http://172.17.0.1:11434/v1"
# OPENAI_BASE_URL="http://172.17.0.1:11434/v1"
#OPENAI_API_BASE="https://generativelanguage.googleapis.com/v1beta/openai/"
#OPENAI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"

# Model Identification
# The prefix 'ollama/' triggers the local provider logic in CAI
#CAI_MODEL="ollama/qwen3.6:35b"
CAI_MODEL="gemini/gemini-2.5-pro"

# Framework Flags
PROMPT_TOOLKIT_NO_CPR=1
CAI_STREAM=true
CAI_DEBUG=1
OPENAI_AGENTS_DISABLE_TRACING=1
CAI_TOOL_TIMEOUT=500 #500 seconds
